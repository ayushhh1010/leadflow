# LeadFlow configuration template.
#   cp .env.example .env
# Every variable except the POSTGRES_* ones has a working default. Real environment
# variables always take precedence over values in .env.

# --- Docker Compose (docker compose up) -------------------------------------
# PostgreSQL credentials. The database is only reachable inside the Compose
# network; use URL-safe characters in the password (it is embedded in a URL).
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadflow
# Load the demo leads on first start (only when the database has no leads).
SEED_DEMO_DATA=true
# Server timezone, used to place the demo follow-ups on "today". Set it to yours.
TZ=UTC
# Port the web app is published on: http://localhost:3000
WEB_PORT=3000

# --- Backend (FastAPI) — read from this file when run from backend/ -----------
# SQLAlchemy database URL. The local default is a SQLite file inside backend/.
# Docker Compose ignores this and points the API at its PostgreSQL service.
DATABASE_URL=sqlite:///./leadflow.db
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend (Next.js) — export in your shell or put in frontend/.env.local ---
# Where the Next.js server proxies /api/* requests (resolved at build time).
BACKEND_URL=http://localhost:8000
