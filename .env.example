# LeadFlow configuration template.
#   cp .env.example .env
# Every variable has a working default for local development; real environment
# variables always take precedence over values in .env.

# --- Backend (FastAPI) — read from this file when run from backend/ -----------
# SQLAlchemy database URL. The local default is a SQLite file inside backend/.
DATABASE_URL=sqlite:///./leadflow.db
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Frontend (Next.js) — export in your shell or put in frontend/.env.local ---
# Where the Next.js server proxies /api/* requests.
BACKEND_URL=http://localhost:8000
